{
	"name": "t-counters",
	"version": "1.0.0",
	"private": true,
	"description": "Website for T Counters, a granite, marble, and quartz countertop company in Baltimore. Built on the CodeStitch Intermediate kit (Eleventy + SASS).",
	"scripts": {
		"watch:eleventy": "cross-env ELEVENTY_ENV=DEV eleventy --serve",
		"build:eleventy": "cross-env ELEVENTY_ENV=PROD eleventy",
		"start": "npm run watch:eleventy",
		"build": "run-s build:*",
		"preview": "cross-env ELEVENTY_ENV=PROD eleventy --serve",
		"remove-decap": "node scripts/remove-decap.js",
		"remove-demo": "node scripts/remove-demo.js",
		"create-page": "node scripts/create-page.js",
		"import-photos": "node scripts/import-photos.js"
	},
	"license": "UNLICENSED",
	"dependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@codestitchofficial/eleventy-plugin-minify": "^1.1.3",
		"@codestitchofficial/eleventy-plugin-sharp-images": "^2.2.0",
		"@quasibit/eleventy-plugin-sitemap": "^2.2.0",
		"autoprefixer": "^10.5.4",
		"codestitch-sharp-image-automation": "^0.5.0",
		"cross-env": "^10.1.0",
		"cssnano": "^7.1.9",
		"esbuild": "^0.28.2",
		"glob": "^13.0.6",
		"netlify-plugin-cache": "^1.0.3",
		"npm-run-all2": "^8.0.4",
		"postcss": "^8.5.26",
		"sass": "^1.101.7"
	}
}
